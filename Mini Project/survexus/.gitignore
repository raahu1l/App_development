# -------------------------
# FLUTTER / DART
# -------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
generated_plugin_registrant.dart

# Ignore API KEY files (very important)
.env
.env.development
.env.production
.env.local

# -------------------------
# LOGS & TEMP FILES
# -------------------------
*.log
*.tmp
*.swp
*.lock
*.bak
*.old

# -------------------------
# OS / EDITOR FILES
# -------------------------
.DS_Store
*.iml
*.idea/
*.ipr
*.iws
.vscode/

# VSCode launch/tasks settings (optional)
# You can uncomment this if you want to ignore VSCode folder entirely
#.vscode/

# -------------------------
# ANDROID
# -------------------------
/android/.gradle/
/android/captures/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/local.properties   # contains paths — keep private
/android/key.properties     # signing keys (DO NOT UPLOAD)
/android/app/*.keystore     # keystore files
/android/app/*.jks

# Ignore generated Google Services files if needed (optional)
# Remove these lines if you want them included.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# -------------------------
# IOS
# -------------------------
ios/Flutter/.last_build_id
ios/Pods/
ios/Runner.xcworkspace/
ios/build/
xcuserdata/
DerivedData/

# -------------------------
# BACKEND KEYS / SECRETS
# -------------------------
*.secret
*.key
*.pem
*.p12
*.crt

# -------------------------
# RELEASE ARTIFACTS
# -------------------------
*.apk
*.aab
*.ipa
*.app.zip
*.symbols
app.*.map.json
app.*.symbols

# -------------------------
# MISC
# -------------------------
migrate_working_dir/
.history
.svn/
.swiftpm/
atom/
.build/
.buildlog/

# Android Studio & Xcode backups
*.orig
*.rej
